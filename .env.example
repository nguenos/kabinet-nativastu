# Скопируйте в .env для локального запуска с реальными настройками.
# На Render эти значения задаются в разделе Environment.

# Секрет для подписи входа (любая длинная случайная строка)
SESSION_SECRET=

# production включает Secure-cookie
NODE_ENV=development

# Кто имеет доступ к админке (через запятую)
ADMIN_EMAILS=natiyaguenos@gmail.com

# Почта для отправки кода входа (пока пусто — код показывается на экране)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Nati Vastu <no-reply@nativastu.com>

# Секрет вебхука Prodamus (пока пусто — подпись не проверяется)
PRODAMUS_SECRET=
